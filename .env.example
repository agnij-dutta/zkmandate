# zkmandate needs no secrets. These optional variables tune the scripts.

# Path to the nargo binary (scripts/*.sh). Default: $HOME/.nargo/bin/nargo
NARGO=
# Path to the bb binary (scripts/*.sh). Default: $HOME/.bb/bb
BB=
# Number of timed runs per benchmark (sdk `npm run bench`, scripts/bench-native.sh). Default: 10
RUNS=
# `native` makes `npm run demo` prove with the native bb binary via bb.js. Default: Wasm
BACKEND=
